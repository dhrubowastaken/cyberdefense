# CyberDefense Environment Variables
# Copy this to .env and fill in your values
# Sensitive values (API keys) go HERE, not in config.yaml

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# Only needed if using Gemini as LLM provider
GEMINI_API_KEY=

# Ollama base URL (only needed if using Ollama as LLM provider)
# Default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
